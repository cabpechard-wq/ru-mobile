{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "image": "sdk-54",
      "node": "20.19.4",
      "cache": {
        "key": "npm-no-frozen-ci"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "image": "sdk-54",
      "node": "20.19.4",
      "cache": {
        "key": "npm-no-frozen-ci"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "image": "sdk-54",
      "node": "20.19.4",
      "cache": {
        "key": "npm-no-frozen-ci"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
